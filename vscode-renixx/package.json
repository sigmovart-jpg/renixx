{
  "name": "renixx",
  "displayName": "Renixx Language Support",
  "description": "Syntax highlighting, snippets, and language configuration for the Renixx programming language.",
  "version": "1.0.0",
  "publisher": "sigmovart-jpg",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onLanguage:renixx"
  ],
  "main": "./extension.js",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "renixx",
    "renix",
    ".rn"
  ],
  "contributes": {
    "configuration": {
      "title": "Renixx",
      "properties": {
        "renixx.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter with renixx installed."
        }
      }
    },
    "languages": [
      {
        "id": "renixx",
        "aliases": [
          "Renixx",
          "renixx"
        ],
        "extensions": [
          ".rn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "renixx",
        "scopeName": "source.renixx",
        "path": "./syntaxes/renixx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "renixx",
        "path": "./snippets/renixx.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sigmovart-jpg/renixx"
  },
  "license": "MIT",
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "scripts": {
    "install-deps": "npm install"
  }
}